TOKEN=
CLIENT=
GUILD=
DB_URL=
PORT=5000

# Opcional: habilita /play con links de Spotify (tracks, álbumes y playlists).
# Sin estas variables, /play solo funciona con YouTube y búsquedas de texto.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Opcional: reduce los errores 429 (rate limit) de YouTube al alojar el bot en
# una IP de datacenter (Railway, etc). Copiar el header "Cookie" de una sesión
# iniciada en youtube.com desde las herramientas de desarrollador del navegador.
YOUTUBE_COOKIE=
